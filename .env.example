# Optional. With no key set, explanations fall back to deterministic text and the
# app runs fully offline. Eligibility is NEVER decided by a model either way.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=      # also set YM_LLM_MODEL to the model id you want
# YM_LLM_PROVIDER=gemini
# YM_LLM_MODEL=gemini-2.0-flash
# YM_LLM_TIMEOUT_MS=12000

# Demonstration mode: treats proposed constraints as approved, in memory only.
# Never writes to data/annotations.
# YM_SIMULATE=1

# Account storage. Defaults are fine; override only to relocate the files.
# YM_USERS_FILE=data/auth/reviewers.json      # reviewers (authority to approve clauses)
# YM_INVITES_FILE=data/auth/invites.json      # single-use reviewer invite codes (hashed)
# YM_CITIZENS_FILE=data/auth/citizens.json    # OPTIONAL citizen accounts — never required to search
